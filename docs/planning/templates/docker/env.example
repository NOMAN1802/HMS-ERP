# =====================================================================================
# TEMPLATE — example NON-SECRET settings (.env). Secrets are files mounted at /run/secrets/*
# and referenced by *_FILE variables (see compose.prod.yaml and docs/K-docker-design.md §7).
# Values below are SAFE EXAMPLES / placeholders — replace per environment.
# =====================================================================================

# ---- general
APP_ENV=production                 # development | staging | production
LOG_LEVEL=info                     # debug in dev only
PUBLIC_APP_ORIGIN=https://app.example.invalid      # <<placeholder domain>>
DEFAULT_LOCALE=bn-BD               # bn-BD | en  (C-025; per-user preference overrides)
DEFAULT_FACILITY_TIMEZONE=Asia/Dhaka

# ---- database (password via DB_PASSWORD_FILE)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hms
DB_POOL_MAX=10                     # per API process; budget in docs/M §6
DB_STATEMENT_TIMEOUT_MS=15000
DB_TX_TIMEOUT_MS=5000              # interactive transaction timeout (D §9.1)

# ---- redis / bullmq
REDIS_URL=redis://redis:6379/0
QUEUE_PREFIX=hms

# ---- sessions & security (secrets via *_FILE)
SESSION_IDLE_TIMEOUT_MIN=30        # PROPOSED default (CP-12, Q-051)
SESSION_ABSOLUTE_TIMEOUT_H=12      # PROPOSED default
LOGIN_LOCKOUT_THRESHOLD=5          # PROPOSED default
LOGIN_LOCKOUT_MINUTES=15           # PROPOSED default
COOKIE_DOMAIN=app.example.invalid

# ---- object storage (keys via *_FILE)
S3_ENDPOINT=https://s3.example.invalid       # <<provider endpoint>>
S3_REGION=<<region>>
S3_BUCKET=hms-prod-files
S3_FORCE_PATH_STYLE=false
PRESIGNED_URL_TTL_SECONDS=300

# ---- worker
WORKER_CONCURRENCY_PDF=2
WORKER_CONCURRENCY_REPORTS=1
OUTBOX_RELAY_BATCH=200
OUTBOX_RELAY_INTERVAL_MS=500

# ---- observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://<<tools-vps>>:4318
OTEL_SERVICE_NAMESPACE=hms
METRICS_PORT=9464
ERROR_TRACKING_DSN=                # self-hosted Sentry-compatible DSN (leave empty to disable)

# ---- feature availability (OPEN questions stay disabled; see docs/A3)
FEATURE_DEPOSITS=false             # Q-004
FEATURE_DISCOUNTS=false            # Q-019
FEATURE_REFUNDS=false              # Q-021
FEATURE_PAYMENT_GATEWAY=false      # Q-045
