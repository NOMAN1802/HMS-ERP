# syntax=docker/dockerfile:1
# =====================================================================================
# TEMPLATE — UNTESTED. PostgreSQL 18 + pgBackRest in one image, so archive_command can call
# pgbackrest inside the database container (J §8). Pin the base by digest.
# Package availability for the chosen Debian base must be verified (PGDG apt repository).
# =====================================================================================
FROM postgres:18<<-PIN_MINOR>>-bookworm@sha256:<<PIN_DIGEST>>
RUN apt-get update \
 && apt-get install -y --no-install-recommends pgbackrest ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /var/log/pgbackrest /var/lib/pgbackrest /var/spool/pgbackrest \
 && chown -R postgres:postgres /var/log/pgbackrest /var/lib/pgbackrest /var/spool/pgbackrest
# postgresql.conf (mounted) should contain at least:
#   archive_mode = on
#   archive_command = 'pgbackrest --stanza=hms archive-push %p'
#   archive_timeout = 60
#   wal_level = replica
#   shared_preload_libraries = 'pg_stat_statements'
#   timezone = 'UTC'
