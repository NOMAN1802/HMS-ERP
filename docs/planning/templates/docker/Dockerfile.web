# syntax=docker/dockerfile:1
# =====================================================================================
# TEMPLATE — UNTESTED. Next.js staff web app (apps/web) using output: 'standalone'.
# Requires in apps/web/next.config.*:  output: 'standalone',
#                                      outputFileTracingRoot: path.join(__dirname, '../../')
# Build from repo root:  docker build -f docker/Dockerfile.web -t ghcr.io/<<ORG>>/hms-web:<sha> .
# =====================================================================================
ARG NODE_IMAGE=node:24-bookworm-slim@sha256:<<PIN_DIGEST>>
ARG TURBO_VERSION=<<PIN e.g. 2.11.7>>

FROM ${NODE_IMAGE} AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS pruner
ARG TURBO_VERSION
RUN npm install -g turbo@${TURBO_VERSION}
COPY . .
RUN turbo prune @hms/web --docker

FROM base AS deps
COPY --from=pruner /repo/out/json/ .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
COPY --from=pruner /repo/out/full/ .
# Public, non-secret build-time settings only (e.g., default locale). The API URL is same-origin (/api).
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm turbo run build --filter=@hms/web...

FROM ${NODE_IMAGE} AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# Standalone output contains apps/web/server.js plus traced node_modules; static assets are copied explicitly.
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/web/server.js"]
