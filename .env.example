# Copy to .env for local development. Never commit .env.
# Local values match docker/compose.dev.yaml and docker/postgres/initdb/10-roles.sql (dev only).

# Migrations: direct connection as hms_migrator. On Supabase use the direct/session connection (port 5432).
DATABASE_MIGRATOR_URL=postgresql://hms_migrator:dev_migrator@localhost:5432/hms?schema=hms

# Application: hms_app (RLS enforced). On Supabase use the transaction pooler (port 6543).
DATABASE_URL=postgresql://hms_app:dev_app@localhost:5432/hms?schema=hms

VALKEY_URL=redis://localhost:6379/0

API_PORT=4100
TZ=UTC
