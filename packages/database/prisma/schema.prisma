// Authoritative data design: docs/planning/docs/E-database-design.md.
// All tables live in the `hms` schema (never `public`, which Supabase exposes through its Data API).
// IDs are UUIDv7 generated by Prisma: Supabase runs PostgreSQL 17, which lacks built-in uuidv7() (ADR-019).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["hms"]
}

enum TenantStatus {
  PROVISIONING
  PROVISIONED
  ACTIVE
  SUSPENDED
  TERMINATED

  @@schema("hms")
}

model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  code      String       @unique
  nameEn    String?      @map("name_en")
  nameBn    String?      @map("name_bn")
  status    TenantStatus @default(PROVISIONED)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  version   Int          @default(1)

  @@map("tenant")
  @@schema("hms")
}
